APP_NAME="Muscle Labs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://musclelabs.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=musclelabs
DB_USERNAME=root
DB_PASSWORD=

# ── Session (secure in production) ───────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue & Cache ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@musclelabs.co.uk"
MAIL_FROM_NAME="Muscle Labs"
MAIL_ADMIN_ADDRESS="orders@musclelabs.co.uk"

# ── Stripe (get from https://dashboard.stripe.com/apikeys) ────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Royal Mail Click & Drop ───────────────────────────────────────────────────
ROYAL_MAIL_API_BASE_URL=https://api.royalmail.com/click-and-drop
ROYAL_MAIL_CLIENT_ID=
ROYAL_MAIL_CLIENT_SECRET=
ROYAL_MAIL_TOKEN_URL=https://authentication.royalmail.com/token

# ── AWS S3 (for COA file storage in production) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
